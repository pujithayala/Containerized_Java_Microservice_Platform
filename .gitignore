# Git ignore for Containerized Java Microservice Platform

# ─── Java / Maven ───────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ─── IDE ────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.swp
*.swo
.DS_Store

# ─── Node / Frontend ────────────────────
node_modules/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment / Secrets ──────────────
.env
.env.*
!.env.example

# ─── Docker ─────────────────────────────
# (Keep Dockerfiles tracked)

# ─── Logs ───────────────────────────────
*.log
logs/

# ─── OS ─────────────────────────────────
.DS_Store
Thumbs.db
.env
*.log
.DS_Store
target/
.idea/
.vscode/

